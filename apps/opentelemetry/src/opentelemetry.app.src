{application, opentelemetry,
 [{description, "OpenTelemetry OTP release integration"},
  {vsn, "2.0.0"},
  {registered, []},
  {mod, {opentelemetry_app, []}},
  {applications,
   [kernel,
    stdlib,
    opentelemetry_api,
    opentelemetry_sdk
   ]},
  {exclude_paths, ["rebar.lock"]},
  {env, []},
  {modules, []},

  {doc, "doc"},
  {licenses, ["Apache-2.0"]},
  {links, [{"GitHub", "https://github.com/open-telemetry/opentelemetry-erlang"}]}
 ]}.
